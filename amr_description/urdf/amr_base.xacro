<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="amr_bot">
    <!-- ================= BASE LINK ================= -->

    <link name="base_link">

        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <material name="blue"/>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
        </collision>

        <xacro:box_inertia
            mass="${base_mass}"
            x="${base_length}"
            y="${base_width}"
            z="${base_height}"/>

    </link>


    <!-- ================= WHEEL MACRO ================= -->

    <xacro:macro name="wheel" params="prefix x y">

        <link name="${prefix}_wheel">

            <visual>
                <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}"
                              length="${wheel_width}"/>
                </geometry>
                <material name="black"/>
            </visual>

            <collision>
                <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}"
                              length="${wheel_width}"/>
                </geometry>
            </collision>

            <xacro:wheel_inertia
                mass="${wheel_mass}"
                radius="${wheel_radius}"
                width="${wheel_width}"/>

        </link>

        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel"/>
            <origin xyz="${x} ${y} ${wheel_z_offset}"
                    rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>

    </xacro:macro>


    <!-- ================= TWO DRIVE WHEELS ================= -->

    <xacro:wheel
        prefix="left"
        x="0"
        y="${wheel_y_offset}"/>

    <xacro:wheel
        prefix="right"
        x="0"
        y="-${wheel_y_offset}"/>

    <!-- ================= FRONT AND REAR CASTER ASSEMBLIES ================= -->

    <xacro:macro name="caster" params="prefix x">
        <link name="${prefix}_caster_swivel">
            <visual>
                <origin xyz="0 0 -0.01"/>
                <geometry>
                    <cylinder radius="0.012" length="0.04"/>
                </geometry>
                <material name="grey"/>
            </visual>
            <collision>
                <origin xyz="0 0 -0.01"/>
                <geometry>
                    <cylinder radius="0.012" length="0.04"/>
                </geometry>
            </collision>

            <visual>
                <origin xyz="-${caster_trail} 0.023 -0.035"/>
                <geometry>
                    <box size="0.02 0.008 0.07"/>
                </geometry>
                <material name="grey"/>
            </visual>
            <collision>
                <origin xyz="-${caster_trail} 0.023 -0.035"/>
                <geometry>
                    <box size="0.02 0.008 0.07"/>
                </geometry>
            </collision>

            <visual>
                <origin xyz="-${caster_trail} -0.023 -0.035"/>
                <geometry>
                    <box size="0.02 0.008 0.07"/>
                </geometry>
                <material name="grey"/>
            </visual>
            <collision>
                <origin xyz="-${caster_trail} -0.023 -0.035"/>
                <geometry>
                    <box size="0.02 0.008 0.07"/>
                </geometry>
            </collision>

            <inertial>
                <mass value="0.20"/>
                <origin xyz="0 0 -0.035"/>
                <inertia ixx="0.0002" ixy="0" ixz="0"
                         iyy="0.0002" iyz="0"
                         izz="0.0002"/>
            </inertial>
        </link>

        <joint name="${prefix}_caster_swivel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_caster_swivel"/>
            <origin xyz="${x} 0 ${caster_pivot_z}" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
        </joint>

        <link name="${prefix}_caster_wheel">
            <visual>
                <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
                <geometry>
                    <cylinder radius="${caster_wheel_radius}"
                              length="${caster_wheel_width}"/>
                </geometry>
                <material name="black"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
                <geometry>
                    <cylinder radius="${caster_wheel_radius}"
                              length="${caster_wheel_width}"/>
                </geometry>
            </collision>
            <xacro:wheel_inertia
                mass="${caster_wheel_mass}"
                radius="${caster_wheel_radius}"
                width="${caster_wheel_width}"/>
        </link>

        <joint name="${prefix}_caster_wheel_joint" type="continuous">
            <parent link="${prefix}_caster_swivel"/>
            <child link="${prefix}_caster_wheel"/>
            <origin xyz="-${caster_trail} 0 ${wheel_z_offset - wheel_radius + caster_wheel_radius - caster_pivot_z}"
                    rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>
    </xacro:macro>

    <xacro:caster prefix="front" x="${caster_x_offset}"/>
    <xacro:caster prefix="rear" x="-${caster_x_offset}"/>


    <!-- ================= LIDAR ================= -->

    <link name="lidar_link">

        <visual>
            <geometry>
                <cylinder radius="${lidar_radius}"
                          length="${lidar_height}"/>
            </geometry>
            <material name="grey"/>
        </visual>

        <collision>
            <geometry>
                <cylinder radius="${lidar_radius}"
                          length="${lidar_height}"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="${lidar_mass}"/>
            <origin xyz="0 0 0"/>
            <inertia ixx="0.0003" ixy="0" ixz="0"
                     iyy="0.0003" iyz="0"
                     izz="0.0006"/>
        </inertial>

    </link>

    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="0 0 ${lidar_z_offset}"/>
    </joint>


    <!-- ================= IMU ================= -->

    <link name="imu_link">

        <visual>
            <geometry>
                <box size="0.04 0.04 0.015"/>
            </geometry>
            <material name="grey"/>
        </visual>

        <inertial>
            <mass value="${imu_mass}"/>
            <origin xyz="0 0 0"/>
            <inertia ixx="0.00001" ixy="0" ixz="0"
                     iyy="0.00001" iyz="0"
                     izz="0.00001"/>
        </inertial>

    </link>

    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="0 0.12 ${imu_z_offset}"/>
    </joint>

</robot>
