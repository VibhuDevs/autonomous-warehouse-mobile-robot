<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="amr_bot">
    
    <!-- ================= ROBOT DIMENSIONS ================= -->

    <xacro:property name="base_length" value="0.65"/>
    <xacro:property name="base_width" value="0.50"/>
    <xacro:property name="base_height" value="0.20"/>
    <xacro:property name="base_mass" value="18.0"/>

    <!-- ================= WHEEL PARAMETERS ================= -->

    <xacro:property name="wheel_radius" value="0.10"/>
    <xacro:property name="wheel_width" value="0.05"/>
    <xacro:property name="wheel_mass" value="1.0"/>

    <xacro:property name="wheel_y_offset" value="0.275"/>
    <xacro:property name="wheel_z_offset" value="-0.05"/>

    <!-- ================= CASTER PARAMETERS ================= -->

    <xacro:property name="caster_x_offset" value="0.24"/>
    <xacro:property name="caster_trail" value="0.04"/>
    <xacro:property name="caster_pivot_z" value="-0.03"/>
    <xacro:property name="caster_wheel_radius" value="0.05"/>
    <xacro:property name="caster_wheel_width" value="0.035"/>
    <xacro:property name="caster_wheel_mass" value="0.25"/>

    <!-- ================= SENSOR PARAMETERS ================= -->

    <xacro:property name="lidar_radius" value="0.055"/>
    <xacro:property name="lidar_height" value="0.04"/>
    <xacro:property name="lidar_mass" value="0.20"/>
    <xacro:property name="lidar_z_offset" value="0.14"/>

    <xacro:property name="imu_mass" value="0.05"/>
    <xacro:property name="imu_z_offset" value="0.11"/>

    <!-- ================= MATERIALS ================= -->

    <material name="blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
    </material>

    <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
    </material>

    <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
    </material>

    <!-- ================= INERTIAL MACROS ================= -->

    <xacro:macro name="box_inertia" params="mass x y z">
        <inertial>
            <mass value="${mass}"/>
            <origin xyz="0 0 0"/>
            <inertia
                ixx="${mass * (y*y + z*z) / 12}"
                ixy="0"
                ixz="0"
                iyy="${mass * (x*x + z*z) / 12}"
                iyz="0"
                izz="${mass * (x*x + y*y) / 12}"/>
        </inertial>
    </xacro:macro>

    <xacro:macro name="wheel_inertia" params="mass radius width">
        <inertial>
            <mass value="${mass}"/>
            <origin xyz="0 0 0"/>
            <inertia
                ixx="${mass * (3*radius*radius + width*width) / 12}"
                ixy="0"
                ixz="0"
                iyy="${mass * radius*radius / 2}"
                iyz="0"
                izz="${mass * (3*radius*radius + width*width) / 12}"/>
        </inertial>
    </xacro:macro>

</robot>
